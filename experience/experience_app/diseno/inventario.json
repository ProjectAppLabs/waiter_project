  "variantes": {
    "boton": {
      "ruta": "variantes.boton",
      "atributo": "data-ds-boton",
      "predeterminada": "relleno",
      "opciones": [
        {
          "valor": "relleno",
          "descripcion": "Fondo de acento y tinta contrastada, como en J2.",
          "selector": ".sm-primary"
        },
        {
          "valor": "contorno",
          "descripcion": "Superficie del tema con borde y texto de acento legible.",
          "selector": "[data-ds-boton=\"contorno\"]"
        },
        {
          "valor": "suave",
          "descripcion": "Fondo de acento suave con texto contrastado.",
          "selector": "[data-ds-boton=\"suave\"]"
        }
      ]
    },
    "formaBoton": {
      "ruta": "variantes.formaBoton",
      "atributo": "data-ds-forma-boton",
      "predeterminada": "tema",
      "opciones": [
