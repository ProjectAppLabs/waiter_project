        },
        {
          "valor": "pildora",
          "descripcion": "Extremos completamente redondeados.",
          "selector": "[data-ds-forma-boton=\"pildora\"]"
        },
        {
          "valor": "recta",
          "descripcion": "Esquinas rectas sin alterar el área táctil.",
          "selector": "[data-ds-forma-boton=\"recta\"]"
