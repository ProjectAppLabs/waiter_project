DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-replace-with-strong-secret-min-50-chars
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=192.168.56.10,127.0.0.1,localhost
DJANGO_LOG_LEVEL=INFO
# El POS lee el catálogo público de plantillas directo desde el navegador: su origen debe estar aquí (dev: http://192.168.56.10:3000)
DJANGO_CORS_ALLOWED_ORIGINS=http://192.168.56.10:3000
# Base de datos: MySQL 8.4, el estándar de los servidores de ProjectApp (scripts/dev.sh crea el contenedor):
#   docker run -d --name waiter-mysql --restart unless-stopped -p 127.0.0.1:3307:3306 -e MYSQL_ROOT_PASSWORD=waiter-root \
#     -e MYSQL_DATABASE=waiter_core -e MYSQL_USER=waiter -e MYSQL_PASSWORD=waiter -v waiter-mysql-data:/var/lib/mysql \
#     mysql:8.4 --character-set-server=utf8mb4 --collation-server=utf8mb4_0900_ai_ci
# Las pruebas usan la misma conexión con la base test_waiter_core. Sin estas líneas se usa SQLite.
DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=waiter_core
DB_USER=waiter
DB_PASSWORD=waiter
DB_HOST=127.0.0.1
DB_PORT=3307
# vacío = locmem; en prod redis://host:6379/1
DJANGO_CACHE_URL=
# Clave para /internal/v1 de este servicio (invalidar caché de carta)
EXPERIENCE_INTERNAL_KEY=change-me-internal
MENU_CACHE_SECONDS=60
# Marca del restaurante: un cambio llega al comensal en <= este tiempo
BRAND_CACHE_SECONDS=60
# Plantilla del menú resuelta por sede (Plan H); el POS la invalida al guardar
TEMPLATE_CACHE_SECONDS=60

# Solo desarrollo: registro por código ligado a cookie y pago simulado. Producción siempre los rechaza.
DINER_DEMO_ENABLED=true

# Recuperación de contraseña: habilitar solo después de configurar el correo.
DINER_EMAIL_ENABLED=false
DINER_PUBLIC_URL=http://192.168.56.10:3001
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Menu <menu@example.invalid>

# Planificador IA (opcional). Configurar un modelo con Responses y Structured Outputs.
OPENAI_API_KEY=
WA_AGENT_MODEL=
# Tope de intentos IA por restaurante/día (incluye fallos del proveedor)
AGENT_DAILY_LIMIT=200

# Generate once with Fernet.generate_key(); keep outside source control and back it up.
PAYMENTS_FERNET_KEY=
# Llaves maestras del cifrado de sobre (v2) de las credenciales de pago: «id:llave_base64_32_bytes», la primera es la
# vigente. Generar: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
PAYMENTS_MASTER_KEYS=
PAYMENTS_LIVE_ENABLED=false
# Public HTTPS origin that forwards /api/v1/pagos/webhooks/* to Experience.
PAYMENTS_PUBLIC_URL=
# Run manage.py reconcile_payments periodically in the deployment (no charge creation).

# Plan K3: verificación de borradores en navegador (vacío = no disponible). El comando recibe DRAFT_TOKEN, REST y SEDE.
# DESIGN_VERIFIER_CMD=node /ruta/diner/scripts/design-system/verificar-borrador.cjs
# DESIGN_VERIFIER_TIMEOUT=180
# Plan K cierre A: exige la última verificación en verde para publicar plantillas propias (MCP y PUT interno).
# false conserva el modo anterior de desarrollo: MCP solo exige verificar si hay comando; el PUT no lo exige.
DESIGN_VERIFIER_REQUIRED=true

# Plan D · Domicilios y mapas
# Google (búsqueda de direcciones escritas, una consulta por búsqueda). Vacío: se usa OpenStreetMap.
GOOGLE_MAPS_API_KEY=
# OpenStreetMap: Nominatim (dirección del pin) y Photon. Vacíos = servidores públicos, solo para uso liviano; en
# producción con muchos clientes, apuntar a servidores propios con los datos de Colombia.
NOMINATIM_ENABLED=1
NOMINATIM_URL=
PHOTON_URL=
