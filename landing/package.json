{
  "name": "landing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "next dev --hostname ${WAITER_HOST:-192.168.56.10} --port 3002",
    "build": "NODE_OPTIONS=--no-deprecation next build",
    "start": "NODE_OPTIONS=--no-deprecation next start --port 3002",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "generar": "python3 scripts/dc2jsx.py \"design/Landing Waiter.dc.html\" components/sections app/hover.css",
    "generar:legal": "python3 scripts/legal2jsx.py design/legal components/legal"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.8",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@swc/core@1.16.1": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "minimatch": "10.2.6",
    "flatted": "3.4.4"
  },
  "description": "Waiter · landing pública (el home). Reproduce tal cual el diseño «Landing Waiter» de Claude Design."
}
