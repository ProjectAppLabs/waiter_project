# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Versión de la API Graph (la que muestra el panel de Meta)
WA_GRAPH_VERSION=v25.0

# Casos de uso -> WhatsApp -> Personalizar -> Paso 1. Probar -> recuadro "Número de test"
WA_PHONE_NUMBER_ID=
WA_WABA_ID=

# Token del usuario del sistema "Waiter API" (no vence).
# Business Suite -> Configuración -> Usuarios del sistema -> Waiter API -> Generar token
WA_ACCESS_TOKEN=

# Configuración de la app -> Información básica -> Clave secreta de la aplicación -> Mostrar
META_APP_SECRET=

# Lo inventas tú. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# y pega EL MISMO valor en Meta al configurar el webhook.
WA_VERIFY_TOKEN=

# Solo para pruebas: número destinatario verificado (con indicativo, sin +)
WA_TEST_RECIPIENT=573004771554
