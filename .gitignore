# Python
__pycache__/
*.py[cod]
*.sqlite3

# Django
/backend/db.sqlite3
/backend/media/
/backend/staticfiles/
/backend/templates/

# Virtualenv
/backend/venv/
/backend/.venv-audit/

# Node/Next: las dependencias de los tres workspaces (frontend/pos, frontend/diner, frontend/landing) se instalan
# en frontend/node_modules; cada app ignora sus propias salidas en su .gitignore. Sin barra final: los worktrees
# de agentes lo enlazan como symlink.
/frontend/node_modules
*.tsbuildinfo

# Env files
.env
/backend/.env
*.env
!*.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Operational logs
*.log
backend/logs/
!backend/logs/.gitkeep

# Backups (should not be in repo)
backend/backups/
backups/

# Test & Coverage artifacts
.coverage
coverage.json
htmlcov/
test-results/
test-reports/
/backend/.pytest_cache/
/backend/htmlcov/
/backend/.coverage
/backend/coverage.xml
/backend/coverage.json
/backend/coverage_*.json
/backend/pytest-results.xml
/.pytest_cache/
/coverage-report.md

# Alias temporales que scripts/calidad/gate_ronda.py crea para el core canónico de calidad y retira al salir:
# backend → experience, y dentro de frontend/ los e2e y la configuración de ESLint del POS.
/backend
/frontend/e2e
/frontend/eslint.config.mjs
# Coordinación temporal de QA; el engine la retira tras validar.
/.qa-gate-pending

# IDE & tooling
.windsurf/plans/
.idea/
.vscode/
*.swp
*.swo
.claude/settings.local.json
.playwright-mcp/

# OS
.DS_Store
Thumbs.db
.playwright_staging/

# Coverage annotation output (pytest --cov)
/backend/cov_annotate/

# Backup files generated by skill sync / fleet operations
*.bak.*
*.bak/
*.bak.*/

# Rotated logs (RotatingFileHandler: django.log.1, .2, ...)
*.log.[0-9]*

# Configuración de Odoo con secretos (las plantillas .example sí se versionan)
/odoo/compose/odoo.conf

# Worktrees de agentes de la sesión
.claude/worktrees/

# Los venv también como symlink (los worktrees de agentes los enlazan al repo principal)
/experience/venv
/registry/venv

# Figma binario del kit del POS (215 MB): no se versiona
*.fig

# Kits de diseño descargados (60–95 MB); las referencias útiles ya están en docs/diseno/exporty y frontend/diner/public/smart-menu
/*.zip
