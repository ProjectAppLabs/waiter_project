# Copia este archivo a deploy/.env.prod y rellénalo. Nunca lo subas al repositorio.
BASE_DOMAIN=waiter.projectapp.co
ACME_EMAIL=infra@projectapp.co
# Proveedor del DNS del dominio (módulo de caddy-dns) y su token con permiso para editar registros TXT de la zona.
DNS_PROVIDER=cloudflare
DNS_API_TOKEN=

# MySQL. Con el servicio db del compose basta usuario y claves; para un servidor MySQL existente agrega DB_HOST y
# DB_PORT (por defecto db y 3306).
DB_USER=waiter
DB_PASSWORD=
DB_ROOT_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=experience,.waiter.projectapp.co
DJANGO_CORS_ALLOWED_ORIGINS=https://menu.waiter.projectapp.co
POS_URL=https://waiter.projectapp.co
PLATFORM_URL=https://plataforma.waiter.projectapp.co
DINER_PUBLIC_URL=https://menu.waiter.projectapp.co
PAYMENTS_PUBLIC_URL=https://api.waiter.projectapp.co
EXPERIENCE_INTERNAL_KEY=
# Clave Fernet de los secretos de las pasarelas: genérala una vez y guárdala aparte (copias de seguridad).
PAYMENTS_FERNET_KEY=
PAYMENTS_LIVE_ENABLED=false
DINER_DEMO_ENABLED=false

# Correo saliente (invitaciones, códigos, recordatorios de cobro).
EMAIL_HOST=smtppro.zoho.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Waiter <waiter@projectapp.co>
