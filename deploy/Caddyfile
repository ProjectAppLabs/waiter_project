# Certificado comodín *.waiter.projectapp.co por desafío DNS (el HTTP no sirve para comodines). La credencial del
# proveedor de DNS va en .env.prod (DNS_API_TOKEN); ver deploy/README.md.
{
	email {$ACME_EMAIL}
}

(tls_wildcard) {
	tls {
		dns {$DNS_PROVIDER} {$DNS_API_TOKEN}
	}
}

menu.{$BASE_DOMAIN} {
	import tls_wildcard
	encode zstd gzip
	reverse_proxy diner:3000
}

api.{$BASE_DOMAIN} {
	import tls_wildcard
	encode zstd gzip
	# Solo el MCP del diseño y los webhooks de pagos: el resto de la API viaja por el POS y el menú (mismo origen).
	@public path /mcp/* /api/v1/pagos/webhooks/*
	handle @public {
		reverse_proxy experience:8000
	}
	respond 404
}

# El dominio base: la landing en la raíz y el inicio de sesión universal en /login. Son dos aplicaciones de Next en el
# mismo dominio; los archivos de la landing van bajo /_landing (assetPrefix en landing/next.config.ts). Todo lo que no
# es de la landing va al POS: /login, /entrar, sus archivos en /_next y la API por /experience.
{$BASE_DOMAIN} {
	import tls_wildcard
	encode zstd gzip
	@landing path / /privacy /terms /data-deletion /icon.svg /img/* /_landing/*
	handle @landing {
		reverse_proxy landing:3000
	}
	handle {
		reverse_proxy pos:3000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

*.{$BASE_DOMAIN} {
	import tls_wildcard
	encode zstd gzip
	# El POS decide la organización por el subdominio; `platform` abre la consola de ProjectApp.
	reverse_proxy pos:3000 {
		header_up X-Forwarded-Proto {scheme}
	}
}
